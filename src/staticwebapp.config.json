{
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/.well-known/oauth-authorization-server",
      "rewrite": "/.well-known/oauth-authorization-server.json"
    }
  ],
  "navigationFallback": {
    "rewrite": "index.html",
    "exclude": ["/assets/*", "/manifest.json", "/bundle.js*", "/css/*", "/.well-known/oauth-authorization-server*"]
  }
}